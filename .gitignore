# Dependency & build
node_modules/
out/
.env

# Thử nghiệm Spike (sinh lại được, không phải code thật)
spike/

# Tài liệu và asset gốc của công ty: lưu ngoài repo (Drive). Logo dùng cho render được copy vào brand/logos/
/Logos/
/*.pdf

# File media nặng của Spike: giữ trên máy dev, không đưa lên git
docs/spike-evidence/*.mp4
docs/spike-audio/*.mp3
docs/spike-audio/**/*.wav

# Bộ nhớ riêng của agent
.claude/agent-memory/

# Video thật của từng brief
briefs/*/audio/
# Hình/clip MKT gửi cho từng video (có thể có mặt khách, nhân viên): chỉ ở máy MKT, không lên repo công khai
briefs/*/hinh/

.DS_Store

# Nhạc test tự sinh (pnpm gen:test-music)
brand/music/test-pad-01.mp3

# Nhạc bên thứ ba (Pixabay, Mixkit…): không đưa lên repo công khai (license cấm phân phối lại track rời).
# Máy tự tải từ downloadUrl trong manifest: ./reel music:fetch (cai-dat.sh bước 6)
brand/music/pixabay-*.mp3
brand/music/mixkit-*.mp3

# Nhạc MKT tự tìm (./reel music:add): file nhạc + ảnh chụp license, chỉ ở máy MKT
nhac-tu-tim/*
!nhac-tu-tim/.gitkeep
