{
  "name": "redsun-reels",
  "version": "0.0.0",
  "private": true,
  "description": "Hệ thống sản xuất video Reel/TikTok/Shorts nội bộ cho team Marketing Redsun (Claude Code + HyperFrames).",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "new": "node scripts/new.ts",
    "hinh": "node scripts/hinh.ts",
    "snap": "node scripts/snap.ts",
    "bang": "node scripts/bang-canh.ts",
    "validate": "node scripts/validate.ts",
    "build": "node scripts/build.ts",
    "preview": "node scripts/preview.ts",
    "render": "node scripts/render.ts",
    "make": "node scripts/make.ts",
    "render:blank": "node scripts/render-blank.ts",
    "gen:test-music": "node scripts/gen-test-music.ts",
    "gen:sfx": "node scripts/gen-sfx.ts",
    "music:fetch": "node scripts/fetch-music.ts",
    "music:add": "node scripts/music-add.ts",
    "music:page": "node scripts/music-page.ts",
    "music:intro": "node scripts/music-intro.ts",
    "lint:brand": "node scripts/lint-brand.ts",
    "lint:music": "node scripts/lint-music.ts",
    "test": "vitest run",
    "test:render": "node scripts/render-test.ts",
    "test:e2e": "node scripts/make-all-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "info": "node scripts/info.ts",
    "post": "node scripts/post.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.141",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
