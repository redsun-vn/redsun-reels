# redsun-reels — biến môi trường
# File mẫu: chỉ có tên biến, KHÔNG điền giá trị ở đây. Chép thành .env (đã nằm trong .gitignore) rồi điền trên máy.
# Dựng, render, kiểm không cần key. Key chỉ dùng cho tạo cảnh người thật do AI (REQUIREMENTS v0.5 §7.4, M5), Nam cấp.

# Đường dẫn FFmpeg/ffprobe cho HyperFrames. Script của dự án tự đặt từ ffmpeg-static / ffprobe-static;
# chỉ điền khi muốn dùng bản FFmpeg khác.
HYPERFRAMES_FFMPEG_PATH=
HYPERFRAMES_FFPROBE_PATH=

# Tạo cảnh người thật do AI (M5). Bắt buộc khi kiểu hình nguoi-that-ai: Gemini API (Veo 3.1 + ảnh tham chiếu),
# dự án Google Cloud có bật thanh toán, key giới hạn chỉ gọi Generative Language API.
GEMINI_API_KEY=
# Tuỳ chọn: fal.ai để so sánh model khác (Kling…).
FAL_KEY=
